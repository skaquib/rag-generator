# Copy to .env and fill in. Never commit .env.

# Claude API key. Without it the app still works but returns extractive answers
# (verbatim sentences from the documents) instead of generated ones.
ANTHROPIC_API_KEY=

# Model and effort used for answer generation
RAG_MODEL=claude-opus-5-5
RAG_EFFORT=low

# Where knowledge bases are stored
RAG_DATA_DIR=rag_data

# Chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# REST API: set to require an X-API-Key header on every endpoint except /health
RAG_API_KEY=

# Upload limits (API and web UI)
RAG_MAX_UPLOAD_MB=25
RAG_MAX_FILES=20
RAG_MAX_QUESTION_CHARS=2000
